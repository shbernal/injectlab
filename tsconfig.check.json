{
  // Typechecks everything the build config cannot see: tests, dev-only tools, and root
  // config files. The per-package configs are emit-oriented and scoped to `src`, so
  // without this file a broken test would only surface when vitest ran it.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // The package export maps point at `dist`, which a typecheck must not require to exist.
    // The build resolves this through project references instead; this file has none, since
    // it deliberately reads sources rather than declaration output.
    "paths": {
      "@injectlab/core": ["./packages/core/src/index.ts"],
      "@injectlab/core/playwright": ["./packages/core/src/render/playwright.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/tests/**/*.ts", "tools/**/*.ts", "*.config.ts"]
}
