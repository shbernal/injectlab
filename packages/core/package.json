      "import": "./dist/render/playwright.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "charcheck": "^0.4.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "playwright": "^1.62.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
