{
  "name": "@injectlab/core",
  "version": "0.0.2",
  "description": "Inject specs, outlet themes and the render pipeline behind injectlab",
  "keywords": [
    "crisis-exercise",
    "tabletop-exercise",
    "inject",
    "stimulus",
    "screenshot"
  ],
  "author": "shbernal",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/injectlab.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shbernal/injectlab#readme",
  "bugs": {
    "url": "https://github.com/shbernal/injectlab/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
