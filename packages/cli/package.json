{
  "name": "@injectlab/cli",
  "version": "0.0.0",
  "description": "Command line interface for injectlab, generator of crisis-exercise stimuli",
  "keywords": [
    "crisis-exercise",
    "tabletop-exercise",
    "inject",
    "stimulus",
    "cli"
  ],
  "author": "shbernal",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/injectlab.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/shbernal/injectlab#readme",
  "bugs": {
    "url": "https://github.com/shbernal/injectlab/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "inject": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@injectlab/core": "workspace:*"
  }
}
